+TARGET = {
+    "chain": "eth",
+    "token": "0x1111111111111111111111111111111111111111",
+    "as_of_block": 123,
+}
+HOLDERS = [f"0x{value:040x}" for value in (2, 3, 4)]
+BALANCES = {HOLDERS[0]: 60, HOLDERS[1]: 30, HOLDERS[2]: 10}
