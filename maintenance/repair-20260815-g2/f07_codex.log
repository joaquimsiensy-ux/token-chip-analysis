+#!/usr/bin/env python3
+"""F-07 reconciliation receipts must be recomputed from bound artifacts."""
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
+import tempfile
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / "scripts" / "lib"))
+sys.path.insert(0, str(ROOT / "scripts" / "report"))
+
+from receipt_kernel import build_envelope, finalize_envelope
+import shared_release_receipt as shared
+
+
+TARGET = {
+    "chain": "eth",
+    "token": "0x1111111111111111111111111111111111111111",
+    "as_of_block": 123,
+}
+
+
+def _write_json(path: Path, payload) -> None:
+    path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
+
+
+def _ref(path: Path) -> dict:
+    return {
+        "path": path.name,
+        "size": path.stat().st_size,
+        "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+    }
+
+
+def _expect_error(fn, needle: str) -> None:
+    try:
+        fn()
+    except ValueError as exc:
+        if needle and needle not in str(exc):
+            raise AssertionError(f"expected {needle!r}, got {exc!r}") from exc
+        return
+    raise AssertionError("tampered receipt unexpectedly passed deep validation")
+
+
+def _baseline_supply_counterexample(root: Path) -> tuple[dict, dict]:
+    config = root / "config.json"
+    balances = root / "balances.json"
+    stats = root / "replay_stats.json"
+    gmgn = root / "gmgn.csv"
+    _write_json(config, {
+        "token": TARGET["token"], "decimals": 0, "total_supply_human": "100",
+    })
+    # Bound reality sums to 80, while the receipt below self-reports a closed sum of 100.
+    _write_json(balances, {"0x2222222222222222222222222222222222222222": "80"})
+    _write_json(stats, {"max_block": 123, "mint_total_raw": "100", "burn_total_raw": "0"})
+    gmgn.write_text("address,pct\n", encoding="utf-8")
+    envelope = build_envelope(
+        "evm-reconciliation-receipt/v2", TARGET,
+        ROOT / "scripts" / "evm" / "verify_recon.py", "formal",
+        inputs={
+            "config": config, "balances": balances,
+            "replay_stats": stats, "gmgn": gmgn,
+        },
+        input_base=root,
+    )
