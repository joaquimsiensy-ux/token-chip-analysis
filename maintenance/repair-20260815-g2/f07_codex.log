+    _require(isinstance(plan.get("input"), dict)
+             and plan["input"].get("sha256") == input_ref.get("sha256"),
+             "time plan input differs from time receipt input")
+    expected_points = []
+    for field in ("matrix_points", "forced_points"):
+        rows = plan.get(field)
