+        "forced_points": [{"kind": "largest_tx", "tx": "0xabc", "from": HOLDERS[1],
+                           "to": HOLDERS[2], "block": 110, "expected_value_raw": "7"}],
+    }
+    plan_path = _write_json(root / "anchor_plan.json", plan)
+    plan_receipt = finalize_envelope(
