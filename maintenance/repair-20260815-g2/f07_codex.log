+
+class _TimePool:
+    def call_many(self, calls):
+        assert len(calls) == 2
+        log = {"address": TARGET["token"],
+               "topics": [
+                   "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef",
