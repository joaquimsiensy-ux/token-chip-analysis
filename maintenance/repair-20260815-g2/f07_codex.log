#!/usr/bin/env python3
"""独立复核发布硬闸离线契约测试。"""

import hashlib
import importlib.util
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


HERE = Path(__file__).resolve().parent
REPO = HERE.parent.parent
GATE = HERE.parent / "report" / "audit_release_gate.py"
REPRODUCE = HERE.parent / "report" / "reproduce_receipt.py"
