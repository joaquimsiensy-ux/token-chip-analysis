+                         encoding="utf-8")
+    duplicate_item = _mutate_receipt(
+        root, receipt, "anchor_duplicate_receipt.json",
+        lambda value: value.__setitem__("output", _ref(duplicate, root)))
+    _expect_error(lambda: validate(duplicate_item), "duplicate dates")
