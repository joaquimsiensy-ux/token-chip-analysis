+        anchor_target, anchor_receipt = _anchor_fixture(anchor_dir)
+        _test_anchor_mutations(anchor_dir, anchor_target, anchor_receipt)
+    print("PASS test_recon_deep_reverify")
+
+
+if __name__ == "__main__":
+    main()

