+    _require(not plan_errors, f"time plan receipt envelope invalid: {plan_errors[:1]}")
+    _require(plan_receipt.get("schema") == "anchor-plan-receipt/v2"
+             and plan_receipt.get("verdict") == "PASS"
+             and plan_receipt.get("exit_code") == 0,
