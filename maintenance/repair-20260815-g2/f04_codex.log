+    if failures:
+        raise AssertionError("\n".join(failures))
+    print(f"PASS F-04 EVM nonempty code and ABI word checks: {len(tests)}/{len(tests)}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
