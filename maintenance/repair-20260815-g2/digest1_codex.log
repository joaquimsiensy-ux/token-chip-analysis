  1009	            _require(isinstance(value, dict), f"anchor output row {line_no} invalid")
  1010	            rows.append(value)
  1011	    except (OSError, json.JSONDecodeError, ValueError) as exc:
  1012	        raise ValueError(f"anchor output invalid: {exc}") from exc
  1013	    date_range = receipt.get("date_range")
  1014	    _require(isinstance(date_range, dict)
  1015	             and set(date_range) == {"start", "end"}, "anchor date_range invalid")
  1016	    try:
  1017	        start = datetime.fromisoformat(date_range["start"]).date()
  1018	        end = datetime.fromisoformat(date_range["end"]).date()
  1019	    except (TypeError, ValueError) as exc:
  1020	        raise ValueError("anchor date_range invalid") from exc
  1021	    _require(start <= end, "anchor date_range start exceeds end")
  1022	    dates = []
