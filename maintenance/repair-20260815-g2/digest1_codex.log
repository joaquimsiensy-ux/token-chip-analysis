  1055	def _validate_anchor_receipt(root, receipt, target):
  1056	    output_path = _bound_case_ref(root, receipt.get("output"), "anchor output")
  1057	    rows = []
  1058	    try:
  1059	        for line_no, line in enumerate(output_path.read_text(encoding="utf-8").splitlines(), 1):
  1060	            if not line.strip():
  1061	                continue
  1062	            value = json.loads(line, parse_constant=_reject_constant)
  1063	            _require(isinstance(value, dict), f"anchor output row {line_no} invalid")
  1064	            rows.append(value)
  1065	    except (OSError, json.JSONDecodeError, ValueError) as exc:
  1066	        raise ValueError(f"anchor output invalid: {exc}") from exc
  1067	    date_range = receipt.get("date_range")
  1068	    _require(isinstance(date_range, dict)
  1069	             and set(date_range) == {"start", "end"}, "anchor date_range invalid")
  1070	    try:
  1071	        start = datetime.fromisoformat(date_range["start"]).date()
  1072	        end = datetime.fromisoformat(date_range["end"]).date()
  1073	    except (TypeError, ValueError) as exc:
  1074	        raise ValueError("anchor date_range invalid") from exc
  1075	    _require(start <= end, "anchor date_range start exceeds end")
  1076	    dates = []
  1077	    failures = []
  1078	    covered = 0
  1079	    for index, row in enumerate(rows):
  1080	        try:
  1081	            day = datetime.fromisoformat(str(row.get("date"))).date()
  1082	        except ValueError as exc:
  1083	            raise ValueError(f"anchor row {index} date invalid") from exc
  1084	        _require(start <= day <= end, f"anchor row {index} date outside target range")
  1085	        dates.append(day.isoformat())
  1086	        _require(row.get("chain") == "solana"
  1087	                 and str(row.get("mint") or "").lower() == str(target["token"]).lower()
  1088	                 and row.get("as_of_slot") == target["as_of_block"]
  1089	                 and isinstance(row.get("endpoint"), str) and bool(row.get("endpoint")),
  1090	                 f"anchor row {index} identity differs from target")
  1091	        if row.get("error"):
  1092	            failures.append({"date": row.get("date"), "error": row.get("error"),
  1093	                             "from_slot": row.get("from_slot"),
  1094	                             "to_slot": row.get("to_slot")})
  1095	        else:
  1096	            covered += 1
  1097	    _require(len(dates) == len(set(dates)), "anchor output contains duplicate dates")
  1098	    requested = (end - start).days + 1
  1099	    _require(len(rows) == requested, "anchor output row count differs from requested days")
  1100	    coverage = receipt.get("coverage")
  1101	    _require(isinstance(coverage, dict)
  1102	             and coverage.get("requested_days") == requested
  1103	             and coverage.get("covered_days") == covered
  1104	             and coverage.get("failed_days") == len(failures),
  1105	             "anchor coverage differs from output rows")
  1106	    _require(receipt.get("failures") == failures,
  1107	             "anchor failures differ from output error rows")
  1108	    _require(not failures, "PASS anchor receipt contains error rows")
