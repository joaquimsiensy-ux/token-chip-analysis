   987	def _validate_time_receipt(root, receipt, target):
   988	    plan = _validated_time_plan_authority(root, receipt, target)
   989	    expected_points = []
   990	    for field in ("matrix_points", "forced_points"):
   991	        rows = plan.get(field)
   992	        _require(isinstance(rows, list), f"time plan {field} invalid")
   993	        expected_points.extend(_plan_point(row) for row in rows)
   994	    rows = receipt.get("rows")
   995	    _require(isinstance(rows, list) and bool(rows)
   996	             and all(isinstance(row, dict) for row in rows), "time rows invalid")
   997	    _require(Counter(_time_row_point(row) for row in rows) == Counter(expected_points),
   998	             "time rows do not correspond one-to-one with plan points")
   999	    _, transcript = _bound_json_input(root, receipt, "transcript", "time transcript")
  1000	    _require(isinstance(transcript, list) and len(transcript) == len(rows),
