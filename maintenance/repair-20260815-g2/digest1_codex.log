   635	def _validate_recon_balance(root, receipt, observations, balances, target):
   636	    shown = observations.get("balance_reconciliation")
   637	    _require(isinstance(shown, dict), "balance_reconciliation missing")
   638	    requested = shown.get("requested_top_n")
   639	    _require(isinstance(requested, int) and not isinstance(requested, bool)
   640	             and requested > 0,
   641	             "balance_reconciliation requested_top_n must be a positive integer")
   642	    _require(shown.get("selection") == "top_n_then_skip_sinks",
   643	             "balance_reconciliation selection semantics invalid")
   644	    rows = shown.get("rows")
   645	    _require(isinstance(rows, list) and all(isinstance(row, dict) for row in rows),
   646	             "balance_reconciliation rows invalid")
   647	    from supply_semantics import DEAD, ZERO
   648	    expected_addresses = [
   649	        address for address, _ in
   650	        sorted(balances.items(), key=lambda item: (-item[1], item[0]))[:requested]
   651	        if address not in {ZERO, DEAD}
   652	    ]
   653	    addresses = [str(row.get("address") or "").lower() for row in rows]
   654	    _require(addresses == expected_addresses,
   655	             "balance_reconciliation address sequence differs from bound balances")
   656	    counts = Counter()
   657	    for index, (row, address) in enumerate(zip(rows, addresses)):
   658	        _require(row.get("replay_raw") == str(balances[address]),
   659	                 f"balance row {index} replay_raw differs from bound balances")
   660	        status = row.get("status")
   661	        _require(status in {"OK", "MISMATCH", "RPC_ERROR"},
   662	                 f"balance row {index} status invalid")
   663	        counts[status] += 1
   664	        if status == "RPC_ERROR":
   665	            _require("chain_raw" not in row and "diff_raw" not in row,
   666	                     f"balance row {index} RPC_ERROR carries chain values")
   667	            continue
   668	        chain_raw = _integer(row.get("chain_raw"), f"balance row {index} chain_raw")
   669	        diff_raw = chain_raw - balances[address]
   670	        _require(row.get("diff_raw") == str(diff_raw),
   671	                 f"balance row {index} diff_raw is not recomputed")
   672	        _require(status == ("OK" if diff_raw == 0 else "MISMATCH"),
   673	                 f"balance row {index} status is inconsistent with diff_raw")
   674	    _require(shown.get("checked") == len(rows),
   675	             "balance_reconciliation checked differs from rows")
   676	    _require(shown.get("matched") == counts["OK"],
   677	             "balance_reconciliation matched differs from rows")
   678	    _require(shown.get("mismatched") == counts["MISMATCH"],
   679	             "balance_reconciliation mismatched differs from rows")
   680	    _require(shown.get("rpc_errors") == counts["RPC_ERROR"],
   681	             "balance_reconciliation rpc_errors differs from rows")
   682	    _require(not counts["MISMATCH"] and not counts["RPC_ERROR"],
   683	             "PASS balance receipt contains MISMATCH/RPC_ERROR row")
   684	    _require(bool(rows), "balance_reconciliation must check at least one non-sink row")
   685	    _validate_balance_transcript(root, receipt, rows, target)
