   607	def _validate_balance_transcript(root, receipt, rows, target):
   608	    _, transcript = _bound_json_input(
   609	        root, receipt, "transcript", "verify_recon transcript")
   610	    _require(isinstance(transcript, list) and len(transcript) == len(rows),
   611	             "verify_recon transcript length does not match balance rows")
   612	    token = str(target["token"]).lower()
   613	    block = hex(canonical_target(target)["as_of_block"])
   614	    for seq, (call, row) in enumerate(zip(transcript, rows)):
   615	        _require(isinstance(call, dict) and call.get("seq") == seq,
   616	                 f"verify_recon transcript seq {seq} is not continuous")
   617	        _require(call.get("method") == "eth_call",
   618	                 f"verify_recon transcript method {seq} must be eth_call")
   619	        address = str(row.get("address") or "").lower()
   620	        data = "0x70a08231" + "0" * 24 + address.replace("0x", "")
   621	        _require(call.get("params") == [{"to": token, "data": data}, block],
   622	                 f"verify_recon transcript params {seq} do not bind row address/block")
   623	        raw = call.get("result")
   624	        _require(isinstance(raw, str) and raw.startswith("0x") and len(raw) > 2,
   625	                 f"verify_recon transcript result {seq} is not hex")
   626	        try:
   627	            chain_raw = int(raw, 16)
   628	        except ValueError as exc:
   629	            raise ValueError(
   630	                f"verify_recon transcript result {seq} is not hex") from exc
   631	        _require(str(chain_raw) == row.get("chain_raw"),
   632	                 f"verify_recon transcript result {seq} differs from row.chain_raw")
