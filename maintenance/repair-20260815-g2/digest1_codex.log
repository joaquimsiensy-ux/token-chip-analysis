   904	        try:
   905	            matches = (str(log.get("address") or "").lower() == token
   906	                       and len(topics) >= 3 and str(topics[0]).lower() == topic
   907	                       and str(topics[1])[-40:].lower() == expected_from
   908	                       and str(topics[2])[-40:].lower() == expected_to
   909	                       and int(log.get("data", "0x0"), 16) == expected_value)
   910	        except (TypeError, ValueError):
