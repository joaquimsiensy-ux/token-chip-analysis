   688	def _validate_gmgn_divergences(value, label):
   689	    _require(isinstance(value, list), f"{label} must be an ordered list")
   690	    normalized = []
   691	    seen = set()
   692	    keys = {"address", "gmgn_pct", "replay_pct", "diff_pp"}
   693	    for index, row in enumerate(value):
   694	        _require(isinstance(row, dict) and set(row) == keys,
   695	                 f"{label}[{index}] fields invalid")
   696	        address = row.get("address")
   697	        _require(isinstance(address, str) and bool(address) and address == address.lower(),
   698	                 f"{label}[{index}].address invalid")
   699	        _require(address not in seen, f"{label} duplicate address: {address}")
   700	        seen.add(address)
   701	        item = {"address": address}
   702	        for key in ("gmgn_pct", "replay_pct", "diff_pp"):
   703	            raw = row.get(key)
   704	            parsed = _decimal(raw, f"{label}[{index}].{key}")
   705	            _require(isinstance(raw, str) and str(parsed) == raw,
   706	                     f"{label}[{index}].{key} must use canonical Decimal spelling")
   707	            item[key] = raw
   708	        normalized.append(item)
   709	    return normalized
