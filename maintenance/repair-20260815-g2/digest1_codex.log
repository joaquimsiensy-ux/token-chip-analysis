   553	def _recon_bound_reality(root, receipt, target):
   554	    _, config = _bound_json_input(root, receipt, "config", "verify_recon config")
   555	    _, balances_raw = _bound_json_input(
   556	        root, receipt, "balances", "verify_recon balances")
   557	    _, stats = _bound_json_input(
   558	        root, receipt, "replay_stats", "verify_recon replay_stats")
   559	    _require(isinstance(config, dict), "verify_recon config must be an object")
   560	    _require(isinstance(balances_raw, dict) and bool(balances_raw),
   561	             "verify_recon balances must be a non-empty object")
   562	    _require(isinstance(stats, dict), "verify_recon replay_stats must be an object")
   563	    config_token = str(config.get("token") or "").lower()
   564	    _require(config_token == str(target["token"]).lower(),
   565	             "verify_recon config token does not match target token")
   566	    decimals = config.get("decimals")
   567	    _require(isinstance(decimals, int) and not isinstance(decimals, bool) and decimals >= 0,
   568	             "verify_recon config decimals invalid")
   569	    supply_human = _decimal(config.get("total_supply_human"),
   570	                            "verify_recon total_supply_human")
   571	    nominal = int(supply_human * (Decimal(10) ** decimals))
   572	    balances = {}
   573	    for raw_address, raw_value in balances_raw.items():
   574	        address = str(raw_address).lower()
   575	        _require(bool(address) and address not in balances,
   576	                 f"verify_recon balances duplicate/empty address: {address!r}")
   577	        balances[address] = _integer(raw_value, f"verify_recon balance {address}")
   578	    stats_end = stats.get("max_block")
   579	    if stats_end is None:
   580	        stats_end = stats.get("last_block")
   581	    _require(_integer(stats_end, "verify_recon replay_stats cutoff")
   582	             == canonical_target(target)["as_of_block"],
   583	             "verify_recon replay_stats cutoff does not match target.as_of_block")
   584	    try:
   585	        mint, burn = parse_replay_stats(stats)
   586	    except Exception as exc:
   587	        raise ValueError(f"verify_recon replay_stats mint/burn invalid: {exc}") from exc
   588	    balance_sum = sum(balances.values())
   589	    negatives = sorted(address for address, value in balances.items() if value < 0)
   590	    closed = mint == nominal and balance_sum == mint and not negatives
   591	    return balances, {
   592	        "mint_total_raw": str(mint), "burn_total_raw": str(burn),
   593	        "nominal_supply_raw": str(nominal), "balance_sum_raw": str(balance_sum),
   594	        "negative_count": len(negatives), "negative_addresses": negatives,
   595	        "closed": closed,
   596	    }, nominal
