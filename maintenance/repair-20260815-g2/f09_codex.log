   260	def canonical_target(target):
   261	    if not isinstance(target, dict) or set(target) != {"chain", "token", "as_of_block"}:
   262	        raise ValueError("target must contain exactly chain/token/as_of_block")
   263	    slot = target.get("as_of_block")
   264	    if isinstance(slot, bool) or not isinstance(slot, int) or slot < 0:
   265	        raise ValueError("target as_of_block/slot must be a non-negative integer")
   266	    chain = resolve_alias(target.get("chain"))
   267	    token = str(target.get("token") or "").strip().lower()
   268	    if not chain or not token:
   269	        raise ValueError("target chain/token must be non-empty")
   270	    return {"chain": chain, "token": token, "as_of_block": slot}
