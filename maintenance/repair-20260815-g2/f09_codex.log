    46	def rpc_balance_of(pool, token, address, block, transcript):
    47	    data = "0x70a08231" + "0" * 24 + address.lower().replace("0x", "")
    48	    params = [{"to": token, "data": data}, hex(int(block))]
    49	    response = pool.call("eth_call", params)
    50	    raw = response.get("result")
    51	    if not response.get("ok") or not isinstance(raw, str) or raw in ("", "0x"):
    52	        raise ValueError(f"eth_call 无有效 result: {response.get('error') or raw!r}")
    53	    transcript.append({"seq": len(transcript), "method": "eth_call",
    54	                       "params": params, "result": raw})
    55	    return int(raw, 16)
