   217	    _require(isinstance(request, dict) and set(request) == request_keys,
   218	             "over-cap approval request fields invalid")
   219	    request_observed = request.get("observed_diff_bps")
   220	    request_tolerance = request.get("requested_tolerance_bps")
   221	    _require(_finite_number(request_observed),
   222	             "over-cap approval request.observed_diff_bps must be finite and non-negative")
   223	    _require(_finite_number(request_tolerance, integer=True),
   224	             "over-cap approval request.requested_tolerance_bps must be finite non-negative integer")
   225	    recomputed_sha = _canonical_request_sha256(request)
   226	    _require(approval.get("request_sha256") == recomputed_sha,
