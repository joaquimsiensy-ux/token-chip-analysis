   273	def _bound_case_ref(root, ref, label, *, base=None):
   274	    if not isinstance(ref, dict) or not {"path", "size", "sha256"} <= set(ref):
   275	        raise ValueError(f"{label} must bind path/size/sha256")
   276	    case_root = Path(root).resolve()
   277	    base = Path(base or case_root).resolve()
   278	    raw = Path(str(ref.get("path") or ""))
   279	    if not raw.parts or ".." in raw.parts:
   280	        raise ValueError(f"{label} path must be a safe contained path")
   281	    lexical = raw if raw.is_absolute() else base / raw
   282	    current = Path(lexical.anchor) if lexical.is_absolute() else Path()
   283	    for part in lexical.parts[1:] if lexical.is_absolute() else lexical.parts:
   284	        current = current / part
   285	        if current.is_symlink():
   286	            raise ValueError(f"{label} path is a symlink")
   287	    try:
   288	        path = lexical.resolve(strict=True)
   289	        path.relative_to(case_root)
   290	    except (OSError, ValueError) as exc:
   291	        raise ValueError(f"{label} file invalid or escapes case root") from exc
   292	    if not path.is_file():
   293	        raise ValueError(f"{label} is not a regular file")
   294	    _require(not isinstance(ref.get("size"), bool) and isinstance(ref.get("size"), int)
   295	             and ref.get("size") == path.stat().st_size,
   296	             f"{label} size mismatch")
   297	    _require(ref.get("sha256") == sha(path), f"{label} sha256 mismatch")
   298	    return path
