   823	def _validate_anchor_receipt(root, receipt, target):
   824	    output_path = _bound_case_ref(root, receipt.get("output"), "anchor output")
   825	    rows = []
   826	    try:
   827	        for line_no, line in enumerate(output_path.read_text(encoding="utf-8").splitlines(), 1):
   828	            if not line.strip():
   829	                continue
   830	            value = json.loads(line, parse_constant=_reject_constant)
   831	            _require(isinstance(value, dict), f"anchor output row {line_no} invalid")
   832	            rows.append(value)
   833	    except (OSError, json.JSONDecodeError, ValueError) as exc:
   834	        raise ValueError(f"anchor output invalid: {exc}") from exc
   835	    date_range = receipt.get("date_range")
   836	    _require(isinstance(date_range, dict)
   837	             and set(date_range) == {"start", "end"}, "anchor date_range invalid")
   838	    try:
   839	        start = datetime.fromisoformat(date_range["start"]).date()
   840	        end = datetime.fromisoformat(date_range["end"]).date()
   841	    except (TypeError, ValueError) as exc:
   842	        raise ValueError("anchor date_range invalid") from exc
   843	    _require(start <= end, "anchor date_range start exceeds end")
   844	    dates = []
   845	    failures = []
   846	    covered = 0
   847	    for index, row in enumerate(rows):
   848	        try:
   849	            day = datetime.fromisoformat(str(row.get("date"))).date()
   850	        except ValueError as exc:
   851	            raise ValueError(f"anchor row {index} date invalid") from exc
   852	        _require(start <= day <= end, f"anchor row {index} date outside target range")
   853	        dates.append(day.isoformat())
   854	        _require(row.get("chain") == "solana"
   855	                 and str(row.get("mint") or "").lower() == str(target["token"]).lower()
   856	                 and row.get("as_of_slot") == target["as_of_block"]
   857	                 and isinstance(row.get("endpoint"), str) and bool(row.get("endpoint")),
   858	                 f"anchor row {index} identity differs from target")
   859	        if row.get("error"):
   860	            failures.append({"date": row.get("date"), "error": row.get("error"),
   861	                             "from_slot": row.get("from_slot"),
   862	                             "to_slot": row.get("to_slot")})
   863	        else:
   864	            covered += 1
   865	    _require(len(dates) == len(set(dates)), "anchor output contains duplicate dates")
   866	    requested = (end - start).days + 1
   867	    _require(len(rows) == requested, "anchor output row count differs from requested days")
   868	    coverage = receipt.get("coverage")
   869	    _require(isinstance(coverage, dict)
   870	             and coverage.get("requested_days") == requested
   871	             and coverage.get("covered_days") == covered
   872	             and coverage.get("failed_days") == len(failures),
   873	             "anchor coverage differs from output rows")
   874	    _require(receipt.get("failures") == failures,
   875	             "anchor failures differ from output error rows")
   876	    _require(not failures, "PASS anchor receipt contains error rows")
