   715	    try:
   716	        receipt_block = int(raw_receipt.get("blockNumber", "0x0"), 16)
   717	        expected_value = _integer(row.get("expect_raw"), "time tx expect_raw")
   718	    except (TypeError, ValueError):
   719	        return False, 0
   720	    topic = "0xddf252ad1be2c89b69c2b068fc378daa952ba7f163c4a11628f55a4df523b3ef"
   721	    expected_from = str(row.get("from") or "").lower().replace("0x", "").rjust(40, "0")[-40:]
   722	    expected_to = str(row.get("to") or "").lower().replace("0x", "").rjust(40, "0")[-40:]
   723	    hit = False
   724	    for log in raw_receipt.get("logs") or []:
   725	        topics = log.get("topics") or [] if isinstance(log, dict) else []
   726	        try:
   727	            matches = (str(log.get("address") or "").lower() == token
   728	                       and len(topics) >= 3 and str(topics[0]).lower() == topic
   729	                       and str(topics[1])[-40:].lower() == expected_from
   730	                       and str(topics[2])[-40:].lower() == expected_to
   731	                       and int(log.get("data", "0x0"), 16) == expected_value)
   732	        except (TypeError, ValueError):
   733	            matches = False
   734	        if matches:
   735	            hit = True
   736	            break
   737	    block_ok = row.get("block") is None or receipt_block == row.get("block")
   738	    return hit and block_ok, receipt_block
