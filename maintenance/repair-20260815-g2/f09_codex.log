   189	    except ValueError as exc:
   190	        raise TolerancePolicyError(f"waiver {label} 越界（必须在 waiver 同目录内）") from exc
   191	    if not path.is_file():
   192	        raise TolerancePolicyError(f"waiver {label} 不是普通文件")
   193	    actual_size = path.stat().st_size   # OSError 归 exit 1
   194	    actual_sha = _sha256_file(path)     # 同上：读不动是通道故障，不是政策问题
   195	    if (isinstance(ref.get("size"), bool) or not isinstance(ref.get("size"), int)
