   123	    韩文音节与全角可打印形式。两侧刻意双写（独立重验纪律），改动须两处同步并过
   124	    行为向量守卫。
   125	    """
   126	    if not isinstance(value, str):
   127	        return False
   128	    for char in value:
   129	        codepoint = ord(char)
   130	        if 0x21 <= codepoint <= 0x7E:
   131	            return True
   132	        if 0x00A1 <= codepoint <= 0x024F and codepoint != 0x00AD:
   133	            return True
   134	        if 0x2010 <= codepoint <= 0x2027:
   135	            return True
   136	        if 0x3001 <= codepoint <= 0x3029 or 0x3030 <= codepoint <= 0x303D:
   137	            return True
   138	        if 0x3041 <= codepoint <= 0x3096 or 0x309B <= codepoint <= 0x30FF:
   139	            return True
   140	        if 0x3400 <= codepoint <= 0x4DBF or 0x4E00 <= codepoint <= 0x9FFF:
   141	            return True
   142	        if 0xAC00 <= codepoint <= 0xD7A3:
   143	            return True
   144	        if 0xFF01 <= codepoint <= 0xFF5E:
