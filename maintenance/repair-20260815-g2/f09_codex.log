   492	def _balance_of_data(address):
   493	    return SEL_BALANCE + "0" * 24 + address.removeprefix("0x").lower()
   494	
   495	
   496	def fetch_sink_reconciliation(pool, token, as_of_block):
   497	    """在同一冻结块批量取得终态标量与两个 sink 的逐地址余额。"""
   498	    tag = hex(int(as_of_block))
   499	    calls = [
   500	        ("eth_call", [{"to": token, "data": SEL_TOTSUP}, tag]),
   501	        ("eth_call", [{"to": token, "data": _balance_of_data(ZERO)}, tag]),
   502	        ("eth_call", [{"to": token, "data": _balance_of_data(DEAD)}, tag]),
   503	    ]
   504	    responses = pool.call_many(calls)
   505	    if not isinstance(responses, list) or len(responses) != len(calls):
   506	        raise ValueError("sink reconciliation RPC 返回数量不完整")
   507	    return tuple(_parse_eth_call_value(response, label) for response, label in zip(
   508	        responses, ("totalSupply", "balanceOf(ZERO)", "balanceOf(DEAD)")))
   509	
   510	
   511	def fetch_onchain_supply(chain, token=None, mint=None, rpc=None, proxy=None,
   512	                         as_of_block=None, pool=None):
   513	    """返回 (最小单位总供给, Solana observed context slot|None)。"""
   514	    url = rpc or DEFAULT_RPC[chain]
   515	    if chain == "solana":
   516	        raise ValueError(
   517	            "Solana formal supply is consumed from --observation-bundle; direct RPC is forbidden")
   518	    tag = hex(int(as_of_block)) if as_of_block is not None else "latest"
   519	    pool = pool or attested_rpc_pool(url, chain, formal=True, proxy=proxy,
   520	                                    rps=2, concurrency=1)
   521	    response = pool.call("eth_call", [{"to": token, "data": SEL_TOTSUP}, tag])
   522	    return _parse_eth_call_value(response, "totalSupply"), None
