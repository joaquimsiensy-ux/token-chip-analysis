   239	    _require(approval_replay == replay_path,
   240	             "over-cap approval request.replay_stats does not bind waiver input")
   241	    for label in ("nonce", "user_approval", "reported_to_user", "approved_by"):
   242	        _require(_meaningful_text(approval.get(label)),
   243	                 f"over-cap approval {label} invalid")
   244	    decided_at = _utc_datetime(
   245	        approval.get("user_decided_at_utc"),
   246	        "over-cap approval user_decided_at_utc")
   247	    expires_at = _utc_datetime(
   248	        approval.get("expires_at_utc"), "over-cap approval expires_at_utc")
   249	    now = datetime.now(timezone.utc)
   250	    _require(decided_at <= now + timedelta(days=1),
   251	             "over-cap approval user_decided_at_utc later than now+1d")
   252	    _require(expires_at > decided_at,
   253	             "over-cap approval expires_at_utc must follow user_decided_at_utc")
   254	    _require(expires_at - decided_at <= timedelta(days=30),
   255	             "over-cap approval lifetime must not exceed 30 days")
