   306	def _bound_replay_totals(root, receipt):
   307	    """读收据 inputs 绑定的那份 replay_stats 实物，解出 (path, mint_total, burn_total)。
   308	
   309	    上游 validate_receipt 已经对这个文件做过"存在＋size＋sha256"三验，所以这里直接读
   310	    内容即可；读不出 mint/burn（旧格式、字段缺失）一律 fail-closed，不放行。
   311	
   312	    实物**必须落在案根内**（N-1）：上游三验只管"这个路径上的文件与收据登记的哈希一致"，
   313	    不管它在哪。绑一份案外伪造账本同样自洽，而案根里那本真账没人再看一眼——
   314	    伪造件不进案目录，就不会出现在 audit_input_manifest 的清单里、人工翻案子时也看不见，
   315	    等于绕开了本仓"内容绑定"防线的全部可见性。强制在案根内之后，伪造者只能覆盖案内那份
   316	    真账本，那会立刻把 balance/supply 两查收据的输入哈希打炸，一望即知。
   317	    resolve() 已经跟完符号链接，所以"案内软链指向案外"也会在这里被拦下。
   318	    """
   319	    inputs = receipt.get("inputs") or {}
   320	    replay_input = inputs.get("replay_stats")
   321	    _require(isinstance(replay_input, dict),
   322	             "supply_truth receipt must bind replay_stats input")
   323	    shown = Path(str(replay_input.get("path") or ""))
   324	    # A-3：收据可记案根相对路径（可搬家）；相对路径基于案根解析，绝对路径照旧收紧。
   325	    replay_path = (shown if shown.is_absolute() else Path(root) / shown).resolve()
   326	    try:
   327	        replay_path.relative_to(Path(root).resolve())
   328	    except ValueError as exc:
   329	        raise ValueError(
   330	            f"收据绑定的 replay_stats 实物不在当前案根内——{MIGRATION_HINT}"
   331	            "（对账实物必须与收据同案；存量案或整目录复制过的案子，收据里记的是老绝对路径）"
   332	        ) from exc
   333	    try:
   334	        stats = json.loads(replay_path.read_text(encoding="utf-8"))
   335	        if not isinstance(stats, dict):
   336	            raise TypeError("replay_stats 不是 JSON 对象")
   337	        mint_total, burn_total = parse_replay_stats(stats)
   338	    except Exception as exc:
   339	        raise ValueError(
   340	            f"supply_truth 绑定的 replay_stats 解不出 mint/burn: {exc}；"
   341	            f"{MIGRATION_HINT}") from exc
   342	    return replay_path, mint_total, burn_total
