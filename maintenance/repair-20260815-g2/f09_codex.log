   152	
   153	
   154	def _utc_datetime(value, label: str) -> datetime:
   155	    try:
   156	        if not isinstance(value, str) or not value.endswith("Z"):
   157	            raise ValueError
   158	        parsed = datetime.fromisoformat(value[:-1] + "+00:00")
