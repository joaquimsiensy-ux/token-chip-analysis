   345	def _validate_tolerance_policy(root, receipt, target):
   346	    """独立重算 primary 结论，并重验 formal 容差与 waiver 输入绑定。"""
   347	    try:
   348	        replay_net = int(str(receipt.get("replay_net")))
   349	        onchain = int(str(receipt.get("onchain_total_supply")))
   350	    except (TypeError, ValueError) as exc:
   351	        raise ValueError("supply_truth primary inputs are not integers") from exc
   352	    tolerance = receipt.get("tolerance_bps")
   353	    _require(not isinstance(tolerance, bool) and isinstance(tolerance, int)
   354	             and tolerance >= 0,
   355	             "supply_truth formal tolerance_bps must be a non-negative integer")
   356	    recomputed_verdict, _, recomputed_diff_bps = decide(replay_net, onchain, tolerance)
   357	    _require(receipt.get("primary_verdict") == recomputed_verdict,
   358	             "supply_truth primary_verdict 与 decide 独立重算值不一致")
   359	
   360	    # 消费侧不能只拿收据自报的三个数互相印证：replay_net 必须对得上案根里那份被哈希
   361	    # 绑定的 replay_stats 实物，否则改一个数就能绕开整套容差钳制与 waiver（F-A）。
   362	    replay_path, stats_mint, stats_burn = _bound_replay_totals(root, receipt)
   363	    _require(stats_mint - stats_burn == replay_net,
   364	             f"supply_truth replay_net 与绑定 replay_stats 实物的 mint−burn 不一致；"
   365	             f"{MIGRATION_HINT}")
   366	
   367	    inputs = receipt.get("inputs") or {}
   368	    waiver_input = inputs.get("tolerance_waiver")
   369	    if tolerance > FORMAL_TOLERANCE_BPS_MAX:
   370	        _require(isinstance(waiver_input, dict),
   371	                 f"supply_truth formal tolerance above "
   372	                 f"{FORMAL_TOLERANCE_BPS_MAX}bps lacks tolerance waiver")
   373	    if waiver_input is None:
   374	        return
   375	
   376	    waiver_shown = Path(str(waiver_input.get("path") or ""))
   377	    waiver_path = (waiver_shown if waiver_shown.is_absolute()
   378	                   else Path(root) / waiver_shown).resolve()
   379	    try:
   380	        waiver_path.relative_to(Path(root).resolve())
   381	    except ValueError as exc:
   382	        raise ValueError(
   383	            f"收据记录的 tolerance waiver 路径不在当前案根内——{MIGRATION_HINT}"
   384	            "（存量案或整目录复制过的案子，收据里记的是老绝对路径，不是 waiver 放错了地方）"
   385	        ) from exc
   386	    # 读不动＝通道故障，JSON 坏了＝内容不合法，两类别再顶着同一句"JSON invalid"（F-D）。
   387	    try:
   388	        waiver_text = waiver_path.read_text(encoding="utf-8")
   389	    except OSError as exc:
   390	        raise ValueError(
   391	            f"tolerance waiver 文件读取失败（通道故障，非政策问题）: {exc}") from exc
   392	    try:
   393	        waiver = json.loads(waiver_text, parse_constant=_reject_constant)
   394	    except (json.JSONDecodeError, ValueError, RecursionError) as exc:
   395	        raise ValueError(f"tolerance waiver JSON invalid: {exc}") from exc
   396	    required = {
   397	        "schema", "approved_tolerance_bps", "approved_by", "user_decided_at_utc",
   398	        "target", "replay_stats", "evidence_refs", "reason", "observed_diff_bps",
   399	    }
   400	    _require(isinstance(waiver, dict)
   401	             and all(key in waiver and waiver.get(key) not in (None, "", [])
   402	                     for key in required),
   403	             "tolerance waiver schema or required fields incomplete")
   404	    _require(waiver.get("schema") == "tolerance-waiver/v1",
   405	             "tolerance waiver schema invalid")
   406	    approved = waiver.get("approved_tolerance_bps")
   407	    _require(_finite_number(approved, integer=True),
   408	             "tolerance waiver approved_tolerance_bps invalid")
   409	    observed_diff = waiver.get("observed_diff_bps")
   410	    _require(_finite_number(observed_diff),
   411	             "tolerance waiver observed_diff_bps invalid")
   412	    # 本次实际偏差必须落在裁决人签字时看到的偏差之内；比较值取自同一个 decide()，
   413	    # 与生产侧同源，不会在浮点边界上分叉（F-E）。
   414	    actual_diff = float(0.0 if recomputed_diff_bps is None else recomputed_diff_bps)
   415	    _require(math.isfinite(actual_diff),
   416	             "supply_truth recomputed actual diff must be finite")
   417	    _require(actual_diff <= float(observed_diff),
   418	             "supply_truth 实际偏差超过 tolerance waiver 记录的 observed_diff_bps"
   419	             "——裁决人没见过这么大的偏差，该收据失效须重新人工裁决")
   420	    _require(_meaningful_text(waiver.get("approved_by")),
   421	             "tolerance waiver approved_by invalid")
   422	    _utc_datetime(waiver.get("user_decided_at_utc"),
   423	                  "tolerance waiver user_decided_at_utc")
   424	    _require(waiver.get("target") == target,
   425	             "tolerance waiver target mismatch")
   426	    _require(_meaningful_text(waiver.get("reason")),
   427	             "tolerance waiver reason invalid")
   428	    waiver_replay = _bound_case_ref(
   429	        root, waiver.get("replay_stats"), "tolerance waiver replay_stats",
   430	        base=waiver_path.parent)
   431	    _require(waiver_replay == replay_path,
   432	             "tolerance waiver replay_stats does not bind receipt input")
   433	    evidence_refs = waiver.get("evidence_refs")
   434	    _require(isinstance(evidence_refs, list) and bool(evidence_refs),
   435	             "tolerance waiver evidence_refs invalid")
   436	    evidence_paths = []
   437	    evidence_shas = []
   438	    replay_sha = sha(waiver_replay)
   439	    for index, ref in enumerate(evidence_refs):
   440	        label = f"tolerance waiver evidence_refs[{index}]"
   441	        evidence_path = _bound_case_ref(
   442	            root, ref, label,
   443	            base=waiver_path.parent)
   444	        evidence_paths.append(evidence_path)
   445	        _validate_evidence_content(evidence_path, label)
   446	        evidence_sha = sha(evidence_path)
   447	        evidence_shas.append(evidence_sha)
   448	        # 人工核对证据不能就是被豁免的那份输入自身（F-E）。
   449	        _require(evidence_path != waiver_replay and evidence_sha != replay_sha,
   450	                 f"tolerance waiver evidence_refs[{index}] 不得与 replay_stats 内容相同")
   451	    over_cap_ref = waiver.get("over_cap_approval")
   452	    over_cap = any(value > WAIVER_TOLERANCE_BPS_CAP for value in
   453	                   (approved, observed_diff, tolerance, actual_diff))
   454	    _require(not over_cap or over_cap_ref is not None,
   455	             f"tolerance waiver above {WAIVER_TOLERANCE_BPS_CAP}bps lacks over-cap approval")
   456	    if over_cap_ref is not None:
   457	        approval_path = _bound_case_ref(
   458	            root, over_cap_ref, "tolerance waiver over-cap approval",
   459	            base=waiver_path.parent)
   460	        _require(approval_path not in evidence_paths
   461	                 and sha(approval_path) not in evidence_shas,
   462	                 "tolerance waiver evidence_refs content must be independent of over-cap approval")
   463	        approval_input = inputs.get("over_cap_approval")
   464	        _require(isinstance(approval_input, dict),
   465	                 "supply_truth receipt inputs missing over_cap_approval")
   466	        receipt_approval_path = _bound_case_ref(
   467	            root, approval_input, "supply_truth receipt over_cap_approval")
   468	        _require(receipt_approval_path == approval_path,
   469	                 "supply_truth receipt over_cap_approval does not bind waiver same file")
   470	        _validate_over_cap_approval(
   471	            root, waiver_path, waiver, over_cap_ref, tolerance=tolerance,
   472	            replay_path=waiver_replay)
   473	    _require(tolerance <= approved,
   474	             "supply_truth tolerance exceeds waiver approved_tolerance_bps")
