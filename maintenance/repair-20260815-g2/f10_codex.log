+    with tempfile.TemporaryDirectory(prefix="f10_time_") as td:
+        common = ["--plan", str(Path(td) / "missing-plan.json"),
+                  "--input", str(Path(td) / "missing-input.csv"),
+                  "--chain", "arbitrum", "--token", "0xtoken",
