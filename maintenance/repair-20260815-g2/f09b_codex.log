def write_json(root, name, value):
    (root / name).write_text(json.dumps(value, ensure_ascii=False), encoding="utf-8")


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def repo_ref(rel):
    path = REPO / rel
    return {"path": rel, "sha256": sha(path)}


