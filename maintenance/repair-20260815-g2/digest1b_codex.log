        rel = _rel(path)
        if path.suffix == ".sh":
            text = path.read_text(encoding="utf-8")
            if re.search(r"(?m)^[^#\n]*\bcurl\b", text):
                transports.append({"script": rel, "kind": "curl"})
            if ".tmp" in text and re.search(r"(?m)^[^#\n]*\bmv\b", text):
