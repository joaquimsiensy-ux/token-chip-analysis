+def resolve_bound_source_dir(case_dir, shown):
+    """evm_v2 溯源源参数的目录版 containment 校验（safe_case_file 只认常规文件）。
+
+    校验强度与 safe_case_file 相同：拒绝空值/绝对路径/空段/./.. 段、逐段拒符号链接、
+    realpath 越根拒；额外要求目标存在且为目录。文件级完整性由 provenance
+    source.files 的逐件哈希校验承担，不在此处。
+    """
+    if not isinstance(shown, str) or not shown or not shown.strip():
+        raise ValueError(f"路径必须是案根内非空相对目录: {shown!r}")
+    if os.path.isabs(shown):
+        raise ValueError(f"路径不得是绝对路径: {shown!r}")
+    parts = shown.split("/")
+    if any(part in {"", ".", ".."} for part in parts):
+        raise ValueError(f"路径含空段、. 或 .. 非法段: {shown!r}")
+    lexical = case_dir
+    for part in parts:
+        lexical = os.path.join(lexical, part)
+        if os.path.islink(lexical):
+            raise ValueError(f"路径不得经过符号链接: {shown!r}")
+    root_real = os.path.realpath(case_dir)
+    target = os.path.realpath(lexical)
+    if os.path.commonpath((target, root_real)) != root_real:
+        raise ValueError(f"路径越出案根: {shown!r}")
+    if not os.path.isdir(target):
+        raise ValueError(f"路径不是目录: {shown!r}")
+    return target
+
