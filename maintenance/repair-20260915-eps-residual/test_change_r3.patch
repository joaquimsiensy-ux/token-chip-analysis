+def eps_rounding_bound(delta, n, supply):
+    """r2 裁决：整数交叉相乘检查 |Δ| <= 4*n*2**-52*S + 2。"""
+    return abs(delta) * 2 ** 52 <= 4 * n * supply + 2 * 2 ** 52
