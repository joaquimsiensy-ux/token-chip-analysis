    27	def sha256(path: Path) -> str:
    28	    digest = hashlib.sha256()
    29	    with path.open("rb") as handle:
    30	        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
    31	            digest.update(chunk)
    32	    return digest.hexdigest()
