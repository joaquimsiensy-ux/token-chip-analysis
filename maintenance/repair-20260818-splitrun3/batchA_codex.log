    35	def is_canonical_checkout(root: Path, home: Path | None = None) -> bool:
    36	    """精确识别正式部署机上的规范 skill checkout。"""
    37	    resolved_home = ACCOUNT_HOME if home is None else home
    38	    canonical = resolved_home / ".claude" / "skills" / "token-chip-analysis"
    39	    return root.resolve() == canonical.resolve()
